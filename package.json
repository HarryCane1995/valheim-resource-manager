{
  "name": "valheim-resource-manager",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "node server/main.mjs",
    "test": "node --test server/*.test.mjs tests/*.test.mjs",
    "test:frontend": "node --test tests/*.test.mjs",
    "desktop:dev": "electron desktop/main.mjs",
    "desktop:pack": "npm run build && node desktop/build.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}
